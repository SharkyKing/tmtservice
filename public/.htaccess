# Vite SPA ant Apache / LiteSpeed (Hostinger).
# Vault: 30-patterns/vite-spa-on-apache-shared-hosting
#
# Be šio failo kiekvienas kelias išskyrus / duotų 404, o puslapio
# perkrovimas ant /robotics sulaužytų svetainę.
#
# `npm run build` nukopijuoja public/ į dist/ kaip yra, tad šis failas
# iškeliauja kartu su bundle. Keliant per FTP – nepamiršti dotfile'o,
# dauguma klientų jį slepia.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Kanoninis hostas: www.tmt.lt ──────────────────────────────
  # Kryptis pasirinkta ne iš skonio: tmt.lt istoriškai nukreipia
  # bare -> www (patikrinta 2026-10-09: https://tmt.lt/robots.txt -> 301 ->
  # https://www.tmt.lt/robots.txt), ir visi canonical tag'ai, sitemap.xml
  # bei robots.txt rodo į www. Pakeitus kryptį gautume suskaldytą
  # indeksavimą tiksliai tada, kai Google skaitys naujus URL.
  #
  # DVI ATSKIROS TAISYKLĖS, NE VIENA SU [OR].
  # Ankstesnė forma `RewriteCond %{HTTPS} !=on [OR]` + `^www\.` ->
  # `https://%{HTTP_HOST}` sukūrė begalinį ciklą: sąlyga suveikdavo www
  # adresui, o %{HTTP_HOST} vis dar nešdavo www, tad 301 vesdavo į tą patį
  # URL. Viena taisyklė negali taisyti dviejų skirtingų dalykų, nes
  # pakeitimas yra vienas. Žr. vault/apsauga-irodoma-ja-paleidus.

  # 1) bare -> www (iš karto į https, kad nebūtų dvigubo šuolio)
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) http -> https (hostas jau su www, tad pakeitimas nekeičia hosto)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Seni tmt.lt URL → nauji (301, dėl Google reitingo) ──
  # Vault: 20-knowledge/tmt-seo-migracija
  RewriteRule ^pradzia/?$ /autoservisas [R=301,L]
  RewriteRule ^valdymo-bloku-remontas-galerija/?$ /valdymo-bloku-remontas/galerija [R=301,L]
  RewriteRule ^valdymo-bloku-remontas-kainos/?$ /valdymo-bloku-remontas/kainos [R=301,L]
  RewriteRule ^kontaktai-kaip-mus-rasti/?$ /kontaktai/kaip-mus-rasti [R=301,L]

  # Tikri failai ir katalogai atiduodami kaip yra
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Trūkstami asset'ai – tikri 404, ne app shell su 200
  RewriteRule ^assets/ - [L,R=404]

  # Visa kita – puslapis, kurį piešia aplikacija
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # --- HSTS: SĄMONINGAI NEĮJUNGTAS.
  # Antraštė teisinga ir jos čia reikia, bet ne šią savaitę: naršyklė ją įsimena metams,
  # ir atšaukti negalima — galima tik pakeisti max-age ir laukti, kol pasens. Kol tmt.lt
  # DNS kaip tik keičiamas, viena HTTPS klaida migracijos metu užblokuotų puslapį
  # visiems, kas jau buvo apsilankę. Įjungti PO migracijos, kai HTTPS tikrai stovi:
  # Header always set Strict-Transport-Security "max-age=31536000"
  # Pirma be includeSubDomains — paddomeniai (jei bus) turi suspėti gauti sertifikatus.

  # --- CSP. ĮJUNGTAS (ne Report-Only).
  #
  # Report-Only etapas baigtas 2026-10-09: konsolė perskaityta IŠDIEGTAME puslapyje
  # (blueviolet-rhinoceros staging), ir pažeidimas buvo vienas — GTM įkrovos inline
  # skriptas. Įterptų tag'ų pažeidimų nebuvo, o GTM tikrai veikė (konteineris GTM-MTGK88W,
  # dataLayer užpildytas), tad tyla nebuvo dėl to, kad jis nepaleistas.
  #
  # Tas vienas skriptas dabar leidžiamas pagal sha256, ne per 'unsafe-inline'. Maišą
  # generuoja scripts/build-csp.mjs iš GALUTINIO dist HTML ir įrašo ČIA, į dist/.htaccess —
  # repo failas lieka su žymomis, nes build'as diegiant visada paleidžiamas.
  #
  # Perjungus į tmt.lt verta konsolę perskaityti dar kartą: GTM konteinerio tag'ai gali
  # turėti domenu ribojamus paleidiklius, kurie staging'e nesuveikia.
  # __CSP__ pradžia — generuoja scripts/build-csp.mjs, ranka neredaguoti
  # __CSP__ galas
</IfModule>
