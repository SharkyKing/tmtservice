# Vite SPA ant Apache / LiteSpeed (Hostinger).
# Vault: 30-patterns/vite-spa-on-apache-shared-hosting
#
# Be šio failo kiekvienas kelias išskyrus / duotų 404, o puslapio
# perkrovimas ant /robotics sulaužytų svetainę.
#
# `npm run build` nukopijuoja public/ į dist/ kaip yra, tad šis failas
# iškeliauja kartu su bundle. Keliant per FTP – nepamiršti dotfile'o,
# dauguma klientų jį slepia.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS ir www nuėmimas vienu peradresavimu
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Seni tmt.lt URL → nauji (301, dėl Google reitingo) ──
  # Vault: 20-knowledge/tmt-seo-migracija
  RewriteRule ^pradzia/?$ /autoservisas [R=301,L]
  RewriteRule ^valdymo-bloku-remontas-galerija/?$ /valdymo-bloku-remontas/galerija [R=301,L]
  RewriteRule ^valdymo-bloku-remontas-kainos/?$ /valdymo-bloku-remontas/kainos [R=301,L]
  RewriteRule ^kontaktai-kaip-mus-rasti/?$ /kontaktai/kaip-mus-rasti [R=301,L]

  # Tikri failai ir katalogai atiduodami kaip yra
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Trūkstami asset'ai – tikri 404, ne app shell su 200
  RewriteRule ^assets/ - [L,R=404]

  # Visa kita – puslapis, kurį piešia aplikacija
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # --- HSTS: SĄMONINGAI NEĮJUNGTAS.
  # Antraštė teisinga ir jos čia reikia, bet ne šią savaitę: naršyklė ją įsimena metams,
  # ir atšaukti negalima — galima tik pakeisti max-age ir laukti, kol pasens. Kol tmt.lt
  # DNS kaip tik keičiamas, viena HTTPS klaida migracijos metu užblokuotų puslapį
  # visiems, kas jau buvo apsilankę. Įjungti PO migracijos, kai HTTPS tikrai stovi:
  # Header always set Strict-Transport-Security "max-age=31536000"
  # Pirma be includeSubDomains — paddomeniai (jei bus) turi suspėti gauti sertifikatus.

  # --- CSP. REPORT-ONLY: niekas neblokuojama, pažeidimai tik rašomi į konsolę.
  #
  # Puslapyje gyvas Google Tag Manager (GTM-MTGK88W), o GTM savo prigimtimi įterpia
  # skriptus, kurių sąrašo iš anksto nežinai — todėl griežtas CSP jam yra nuolatinė
  # kova, ir jo įjungimas aklai gyvame kliento puslapyje reikštų, kad analitika nustoja
  # veikti be jokio pranešimo. Report-Only parodo tikrą sąrašą, ko GTM prašo, ir tik
  # tada galima nuspręsti: leisti tuos adresus, pereiti prie nonce, ar atsisakyti GTM.
  #
  # Tikėtini pažeidimai iš karto: GTM įkrovos inline skriptas ir jo įterpiami tag'ai.
  # Tai žinoma, ne staigmena — klausimas tik, kiek jų ir iš kur.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-src https://www.googletagmanager.com https://www.youtube.com https://www.google.com https://maps.google.com https://maps.google.lt; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
